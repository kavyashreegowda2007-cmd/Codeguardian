# ============================================================
# CODEGUARDIAN — Environment Variable Reference
# Copy this file to .env for local development.
# Never commit .env — it is listed in .gitignore.
# ============================================================

# --- Backend -----------------------------------------------

# Port the backend listens on.
# Render injects PORT automatically; leave unset locally to
# use the uvicorn default (8000) or the Dockerfile fallback (8001).
PORT=8001

# CORS: comma-separated list of allowed frontend origins.
# For local dev you can leave this unset (defaults apply).
# For Render, set this to the deployed frontend URL:
#   ALLOWED_ORIGINS=https://<your-frontend>.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database path for analysis storage.
# Defaults to .codeguardian/analyses.sqlite3 relative to the project root.
# CODEGUARDIAN_DB_PATH=/data/.codeguardian/analyses.sqlite3

# --- LLM provider ------------------------------------------

# Choose "openrouter" (default, cloud), "ollama" (local), or "gemini" (cloud).
LLM_PROVIDER=openrouter

# OpenRouter settings (used when LLM_PROVIDER=openrouter)
# Get your API key at https://openrouter.ai/
# OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini settings (used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-3.7-flash

# Nebius Token Factory settings (used when LLM_PROVIDER=nebius or for multi-stage AI analysis)
# Nebius AI Studio was renamed to Nebius Token Factory.
# New API base URL: https://api.tokenfactory.nebius.com/v1/
# Get your API key at https://studio.nebius.com
# NEBIUS_API_KEY=your-nebius-api-key-here
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# NVIDIA NIM / Nebius alternative key name (fallback if NEBIUS_API_KEY is not set)
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NVIDIA_MODEL=nvidia/Nemotron-3.5-Lightning

# --- Frontend (Vite build-time variables) ------------------

# Base URL of the backend API.
# For local dev: http://127.0.0.1:8001  (or 8001 if running via Docker)
# For Render:    https://<your-backend>.onrender.com
VITE_API_URL=http://127.0.0.1:8001
